# Mobile client configuration. Values with EXPO_PUBLIC_ are bundled into the app.
# app.config.ts can also reuse SUPABASE_URL + SUPABASE_ANON_KEY from the shared
# backend .env. Never expose SUPABASE_SERVICE_ROLE_KEY, DATABASE_URL, or AI keys.
EXPO_PUBLIC_API_URL=https://your-learnpath-api.example.com
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# For a physical device during local development, use your computer's LAN URL, not localhost.
# EXPO_PUBLIC_API_URL=http://192.168.1.10:3000
